<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BizCardApp.Views.DashboardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BizCardApp.Views"
    xmlns:viewmodels="using:BizCardApp.ViewModels"
    xmlns:controls="using:BizCardApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}">

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            
            <ListBox ItemsSource="{Binding BusinessCards}"
                     SelectedItem="{Binding SelectedBusinessCard, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BusinessCardViewModel">
                        <TextBlock Text="{x:Bind FullName, Mode=OneWay}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
        </Border>

        <StackPanel Grid.Column="1" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Spacing="15">
            
            <TextBlock Text="Wizytówki" TextAlignment="Center" 
                       FontSize="28" FontWeight="Bold" 
                       Margin="0,0,0,30"/>

            <controls:BusinessCardForm DataContext="{Binding BusinessCardForm}" />

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Spacing="15">
                
                <Button Command="{Binding SaveChangesCommand}" 
                        Width="48" Height="48" 
                        ToolTipService.ToolTip="Zapisz (Ctrl + S)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <Button Command="{Binding AddBusinessCardCommand}" 
                        Width="48" Height="48" 
                        ToolTipService.ToolTip="Dodaj (Ctrl + A)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE8FA;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <Button Command="{Binding DeleteBusinessCardCommand}" 
                        Width="48" Height="48" 
                        ToolTipService.ToolTip="Usuń (Ctrl + D)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE8F8;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                
            </StackPanel>
        </StackPanel>
        
    </Grid>
</UserControl>